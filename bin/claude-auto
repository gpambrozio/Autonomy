#!/bin/bash
#
# claude-auto - Run Claude with a fresh session ID and the Autonomy plugin
# loaded.
#
# Usage:
#   claude-auto [--log <file>] [claude args...] "Your prompt"
#
# Flags added automatically to the inner claude invocation:
#   --session-id <new UUID>
#   --plugin-url <Autonomy main.zip on GitHub>
#
# Permission handling is left to the caller. Pass
# --dangerously-skip-permissions (or any other permission-related flag) in
# the forwarded args if you want it.
#
# Autonomy steers the Claude TUI through tmux, so claude-auto must run inside
# a tmux session. When started outside one, it launches a fresh session and
# re-execs itself inside it (see below); tmux must be installed either way.
#
# When the caller piped our stdout/stderr (e.g. through `tee`), we dup the
# inherited tty stdin into stdout/stderr so claude sees three tty fds and the
# TUI still renders on the user's terminal.
#
# After Claude exits, the session transcript is dumped via claude-transcript.
# Default sink is the wrapper's stdout. Pass --log <file> to append the
# transcript to a file instead.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_URL="https://github.com/gpambrozio/Autonomy/archive/refs/heads/main.zip"

if ! command -v tmux >/dev/null 2>&1; then
    cat >&2 <<'EOF'
claude-auto: tmux is required but was not found on $PATH.

Autonomy drives the Claude TUI by sending keystrokes to the current tmux
pane, so it cannot run outside tmux. Install tmux and retry:

  macOS (Homebrew):  brew install tmux
  Debian / Ubuntu:   sudo apt-get install tmux
  Fedora / RHEL:     sudo dnf install tmux
  Arch Linux:        sudo pacman -S tmux

Once tmux is installed, just re-run claude-auto: it starts its own tmux
session automatically.
EOF
    exit 127
fi

# Autonomy drives the Claude TUI by sending keystrokes to the current tmux
# pane, so we must run inside tmux. If we aren't, bootstrap a fresh session
# and re-exec ourselves inside it, attaching the terminal so the TUI shows.
# tmux hands our argv straight to execvp, so the prompt and every flag survive
# without any quoting; -c keeps the working directory the caller started in.
if [[ -z "${TMUX:-}" ]]; then
    exec tmux new-session -c "$PWD" -s "autonomy-$$" "$0" "$@"
fi

LOG_FILE=""
ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --log)
            if [[ $# -lt 2 ]]; then
                echo "claude-auto: --log requires a file path" >&2
                exit 2
            fi
            LOG_FILE="$2"
            shift 2
            ;;
        --log=*)
            LOG_FILE="${1#--log=}"
            shift
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

UUID="$(uuidgen | tr '[:upper:]' '[:lower:]')"

# A directory claude hasn't been trusted for yet gets a blocking "Is this a
# project you created or one you trust?" dialog before the session starts, so
# no plugin hook can answer it. Set CLAUDE_AUTO_TRUST=0 to leave it to a human.
#
# Two layers, because the cheap one is also the brittle one:
#
#   1. claude-trust-seed records the trust in ~/.claude.json up front. It is
#      deterministic and does not care how the dialog is worded. Its failure is
#      NOT fatal (note the `||` — `set -e` is on): a job is worth more than a
#      tidy config, and layer 2 still covers us.
#   2. claude-trust-watch presses Enter if the dialog shows up anyway — a
#      claude that rewrites the config underneath us, a key we guessed wrong,
#      or a seed that failed above.
if [[ "${CLAUDE_AUTO_TRUST:-1}" != "0" ]]; then
    "$SCRIPT_DIR/claude-trust-seed" "$PWD" \
        || echo "claude-auto: could not pre-trust $PWD; leaving it to claude-trust-watch" >&2
fi

TRUST_WATCH_PID=""
if [[ "${CLAUDE_AUTO_TRUST:-1}" != "0" ]]; then
    "$SCRIPT_DIR/claude-trust-watch" "$TMUX_PANE" &
    TRUST_WATCH_PID=$!
fi

stop_trust_watch() {
    if [[ -n "$TRUST_WATCH_PID" ]]; then
        kill "$TRUST_WATCH_PID" 2>/dev/null || true
        wait "$TRUST_WATCH_PID" 2>/dev/null || true
        TRUST_WATCH_PID=""
    fi
}
trap stop_trust_watch EXIT

# Make sure claude sees a tty on all three of stdin/stdout/stderr so the TUI
# renders even when the caller piped our stdout/stderr.
#
# We can't just open /dev/tty: Bun (the runtime claude is bundled in) crashes
# with "EINVAL: invalid argument, kqueue" when wrapping a /dev/tty fd in a
# tty.WriteStream. The inherited stdin from a shell that has a controlling
# terminal, however, is a normal pty fd opened O_RDWR, which Bun accepts.
#
# So: if any of fd 0/1/2 isn't already a tty, dup the inherited tty stdin
# into it. Realistic call shapes are either "all three are the terminal pty"
# (direct invocation) or "stdin is the pty, stdout/stderr are pipes" (caller
# piped us into `tee`). Both work below.
CLAUDE_EXIT=0
if [ -t 0 ] && [ -t 1 ] && [ -t 2 ]; then
    claude \
        --session-id "$UUID" \
        --plugin-url "$PLUGIN_URL" \
        "${ARGS[@]}" || CLAUDE_EXIT=$?
elif [ -t 0 ]; then
    claude \
        --session-id "$UUID" \
        --plugin-url "$PLUGIN_URL" \
        "${ARGS[@]}" 1>&0 2>&0 || CLAUDE_EXIT=$?
else
    # No tty on stdin to dup from; run as-inherited and let claude decide.
    claude \
        --session-id "$UUID" \
        --plugin-url "$PLUGIN_URL" \
        "${ARGS[@]}" || CLAUDE_EXIT=$?
fi

stop_trust_watch

if [[ -n "$LOG_FILE" ]]; then
    "$SCRIPT_DIR/claude-transcript" --raw "$UUID" >>"$LOG_FILE"
else
    "$SCRIPT_DIR/claude-transcript" --raw "$UUID"
fi

exit "$CLAUDE_EXIT"
